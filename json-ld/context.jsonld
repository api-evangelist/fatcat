{
  "@context": {
    "@version": 1.1,
    "schema": "https://schema.org/",
    "fatcat": "https://fatcat.wiki/schema/",
    "bibo": "http://purl.org/ontology/bibo/",
    "dc": "http://purl.org/dc/terms/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "ReleaseEntity": "fatcat:ReleaseEntity",
    "ContainerEntity": "fatcat:ContainerEntity",
    "CreatorEntity": "fatcat:CreatorEntity",
    "FileEntity": "fatcat:FileEntity",
    "FilesetEntity": "fatcat:FilesetEntity",
    "WebcaptureEntity": "fatcat:WebcaptureEntity",
    "WorkEntity": "fatcat:WorkEntity",
    "Editgroup": "fatcat:Editgroup",

    "ident": { "@id": "fatcat:ident" },
    "revision": { "@id": "fatcat:revision" },
    "state": { "@id": "fatcat:state" },
    "redirect": { "@id": "fatcat:redirect" },
    "extra": { "@id": "fatcat:extra" },

    "title": { "@id": "dc:title" },
    "subtitle": { "@id": "bibo:shortTitle" },
    "original_title": { "@id": "dc:alternative" },
    "release_date": { "@id": "dc:date", "@type": "xsd:date" },
    "release_year": { "@id": "bibo:edition" },
    "release_type": { "@id": "dc:type" },
    "release_stage": { "@id": "bibo:status" },
    "publisher": { "@id": "dc:publisher" },
    "language": { "@id": "dc:language" },
    "license_slug": { "@id": "dc:license" },
    "volume": { "@id": "bibo:volume" },
    "issue": { "@id": "bibo:issue" },
    "pages": { "@id": "bibo:pages" },
    "work_id": { "@id": "fatcat:workId" },
    "container_id": { "@id": "fatcat:containerId" },
    "withdrawn_status": { "@id": "fatcat:withdrawnStatus" },
    "withdrawn_date": { "@id": "fatcat:withdrawnDate", "@type": "xsd:date" },

    "ext_ids": { "@id": "fatcat:extIds" },
    "doi": { "@id": "bibo:doi" },
    "pmid": { "@id": "bibo:pmid" },
    "pmcid": { "@id": "fatcat:pmcid" },
    "isbn13": { "@id": "bibo:isbn13" },
    "arxiv": { "@id": "fatcat:arxiv" },
    "jstor": { "@id": "fatcat:jstor" },
    "oai": { "@id": "fatcat:oai" },
    "wikidata_qid": { "@id": "schema:sameAs" },

    "contribs": { "@id": "dc:contributor", "@container": "@list" },
    "display_name": { "@id": "foaf:name" },
    "given_name": { "@id": "foaf:firstName" },
    "surname": { "@id": "foaf:familyName" },
    "orcid": { "@id": "schema:identifier" },
    "raw_name": { "@id": "foaf:name" },
    "role": { "@id": "schema:roleName" },
    "creator_id": { "@id": "fatcat:creatorId" },

    "refs": { "@id": "bibo:references", "@container": "@list" },
    "abstracts": { "@id": "dc:abstract", "@container": "@list" },
    "content": { "@id": "schema:text" },
    "mimetype": { "@id": "dc:format" },
    "lang": { "@id": "dc:language" },

    "name": { "@id": "schema:name" },
    "container_type": { "@id": "dc:type" },
    "publication_status": { "@id": "bibo:status" },
    "issnl": { "@id": "bibo:issn" },
    "issne": { "@id": "bibo:eissn" },
    "issnp": { "@id": "bibo:issn" },

    "size": { "@id": "schema:contentSize" },
    "md5": { "@id": "fatcat:md5" },
    "sha1": { "@id": "fatcat:sha1" },
    "sha256": { "@id": "fatcat:sha256" },
    "urls": { "@id": "schema:url", "@container": "@set" },
    "url": { "@id": "schema:url" },
    "rel": { "@id": "schema:additionalType" },
    "release_ids": { "@id": "fatcat:releaseIds", "@container": "@set" },
    "content_scope": { "@id": "fatcat:contentScope" },

    "editgroup_id": { "@id": "fatcat:editgroupId" },
    "editor_id": { "@id": "fatcat:editorId" },
    "changelog_index": { "@id": "fatcat:changelogIndex" },
    "created": { "@id": "dc:created", "@type": "xsd:dateTime" },
    "submitted": { "@id": "fatcat:submitted", "@type": "xsd:dateTime" },
    "description": { "@id": "dc:description" }
  }
}
