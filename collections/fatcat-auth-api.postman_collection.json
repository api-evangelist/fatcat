        {
          "id": "822dab62-974f-4653-b40d-4bb6eb96ff23",
          "name": "auth oidc",
          "request": {
            "name": "auth oidc",
            "description": {
              "content": "Login or create editor account using OIDC metadata (internal method).\n\nThis method is used by privileged front-end tools (like the web\ninterface service) to process editor logins using OpenID Connect (OIDC)\nand/or OAuth. Most accounts (including tool and bot accounts) do not\nhave sufficient privileges to call this method, which requires the\n`admin` role.\n\nThe method returns an API token; the HTTP status code indicates whether\nan existing account was logged in, or a new account was created.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "oidc"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"<string>\",\n  \"sub\": \"<string>\",\n  \"iss\": \"<string>\",\n  \"preferred_username\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
