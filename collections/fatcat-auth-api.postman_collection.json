          "request": {
            "name": "create auth token",
            "description": {
              "content": "Generate a new auth token for a given editor (internal method).\n\nThis method is used by the web interface to generate API tokens for\nusers. It can not be called by editors (human or bot) to generate new\ntokens for themselves, at least at this time.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "token",
                ":editor_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "duration_seconds",
                  "value": "<integer>",
                  "description": "How long API token should be valid for (in seconds)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "editor_id",
                  "description": "(Required) "
                }
              ]
